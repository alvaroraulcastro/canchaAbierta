# --- Next.js ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth.js (NextAuth v5) ---
# Generar con: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Admin allowlist (comma-separated) ---
# Emails con permisos de administrador. Cualquier coincidencia promueve al usuario a admin en su primer login.
ALLOWED_ADMIN_EMAILS=

# --- Google Sheets ---
GOOGLE_SHEETS_ID=1VsaQwGX8EE_dnBidWfjJjRPxwA4azMRJi-ziOmbjdxM
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Pegar aquí el contenido de "private_key" del JSON descargado del service account, con saltos de línea escapados como \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Apps Script webhook (token compartido con el script del Sheets) ---
SHEETS_REVALIDATE_SECRET=

# --- Flow.cl (Transbank Webpay REST) ---
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://www.flow.cl/api
FLOW_WEBHOOK_URL=

# --- Resend (emails transaccionales) ---
RESEND_API_KEY=
# Remitente verificado en Resend, ej: no-reply@canchaabierta.cl
RESEND_FROM_EMAIL=

# --- Redis (Vercel Marketplace: locks + idempotencia de webhooks) ---
# Storage > redis-cancha-abiert > Quickstart (.env.local): KV_REDIS_URL
# O en la raíz del repo: vercel link && vercel env pull .env.local
KV_REDIS_URL=
